# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: 右下角「AI 数字员工」对话的**主**模型（DeepSeek，OpenAI 兼容接口）。
# 本地放 .env（已被 .gitignore 忽略）；线上填在部署平台环境变量里（render.yaml 里 sync: false ⇒ 值不进仓库）。
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_BASE_URL **必须含 /v1**；DEEPSEEK_MODEL 默认 deepseek-flash。
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── v7 工具舱（线路测算 / 报关与税费 / 车辆匹配 / 测算助手）─────────────────
# 引擎地址与密钥（站点只经服务端转发；前端永远拿不到这两个值）
# 本地跑网关示例：OSRM_API_BASE="http://127.0.0.1:18001"；线上填网关域名（可带可不带 /api/v1，代码会补）
OSRM_API_BASE="MY_OSRM_API_BASE"
# 必须与网关的 ENGINE_API_KEY 一致（不一致时测算 401，而 /health 仍绿）
OSRM_ENGINE_KEY="MY_OSRM_ENGINE_KEY"
# 工具层调用引擎的等待上限（毫秒，默认 20000，夹到 1000..60000）
OSRM_TOOLS_TIMEOUT_MS="20000"

# 报关费**对外系数**（占位 1.5，上线前必须由业务确认）
# 留空或删除 = fail-closed：公开接口回 available:false「线上暂不提供报关费测算，请联系项目经理」
BORDER_MARKUP="1.5"
# 区间半宽（0.10 = 成本×系数 后 ±10%；RMB 取整 10、VND 取整 10 万）
BORDER_RANGE_PCT="0.10"

# 留资明细令牌：有效期（分钟）与同一来源每小时建线索上限
LEAD_TTL_MIN="30"
LEAD_RATE_PER_HOUR="5"
# 令牌签名密钥（线上必须改成随机长串；改了就使已发出的明细令牌全部失效）
DETAIL_TOKEN_SECRET="change-me-in-render"
# 线索落库目录（JSONL 追加，令牌不入库）与可选转发 webhook（转发失败只 warn）
LEADS_DIR="./data"
LEADS_WEBHOOK_URL=""

# ── v10 报价功能（/quote 客户版 · /quote/internal 内部版）────────────────────
# 报价引擎复用上面的 OSRM_API_BASE（同一个后端），不需要再配一份。
# 内部版共享口令：服务端逐请求比对 x-quote-key。留空或删除 = 内部版整体关闭
# （所有 /api/quote 内部端点回 503 internal_disabled，客户版不受影响）。
# 线上必须改成随机长串；改了之后所有已输过口令的浏览器需重新输入。
QUOTE_INTERNAL_KEY="change-me-random-long-string"

